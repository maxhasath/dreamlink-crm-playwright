{
  "name": "dreamlink-crm-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E automation for DreamLink CRM",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --workers=1",
    "test:headed": "npx playwright test --headed --workers=1",
    "test:login": "npx playwright test tests/specs/login.spec.js --headed --workers=1",
    "test:groups": "npx playwright test tests/specs/groups.spec.js --headed --workers=1",
    "test:users": "npx playwright test tests/specs/users.spec.js --headed --workers=1",
    "test:profile": "npx playwright test tests/specs/userProfile.spec.js --headed --workers=1",
    "test:eligibility": "npx playwright test tests/specs/eligibilityCriteria.spec.js --headed --workers=1",
    "test:criteriasets": "npx playwright test tests/specs/criteriaSets.spec.js --headed --workers=1",
    "report": "npx playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "prettier": "^3.9.6"
  }
}
